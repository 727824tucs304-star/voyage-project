# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# Base domain. Wildcard DNS: *.BASE_DOMAIN must point to this host.
# Local testing: BASE_DOMAIN=localhost (browsers resolve *.localhost to 127.0.0.1).
BASE_DOMAIN=localhost
WORKSPACE_SCHEME=http
HTTP_PORT=8080

# Central PostgreSQL (container only; not published).
PG_ADMIN_PASSWORD=CHANGE_ME_long_random
PROVISIONER_PASSWORD=CHANGE_ME_long_random
CONTROL_DB_URL=postgres://voyage_provisioner:CHANGE_ME_long_random@voyage-postgres:5432/voyage_control
TENANT_PG_HOST=voyage-postgres
TENANT_PG_PORT=5432

# Derives tenant DB passwords and JWT secrets. At least 32 characters. Changing it breaks existing tenants.
CONTROL_SECRET=CHANGE_ME_at_least_32_chars_xxxxxxxxxxxxxxxx

# Bearer token for /api/admin/* (version deploys, rollbacks). At least 24 characters.
ADMIN_TOKEN=CHANGE_ME_admin_token_at_least_24_chars

# GID of the docker group on the host (getent group docker | cut -d: -f3).
DOCKER_GID=999

TENANT_IMAGE_REPO=voyage-tenant
TENANT_DEFAULT_VERSION=v1
